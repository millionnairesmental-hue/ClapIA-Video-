# Exemple d'environnement pour ClapIA-Video

# Clé Fal.ai (obligatoire)
FAL_KEY=your_fal_api_key_here

# Modèle utilisé (par défaut fal-ai/veo3.1)
VIDEO_MODEL=fal-ai/veo3.1

# Redis (optionnel mais recommandé)
REDIS_URL=redis://localhost:6379

# JWT secret (obligatoire en production)
JWT_SECRET=change_this_secret

# Crédits initial et coût par génération (valeurs par défaut pour le demo)
STARTING_CREDITS=20
COST_PER_VIDEO=5
